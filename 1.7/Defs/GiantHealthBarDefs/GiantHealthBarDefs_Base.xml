<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Clean, low-saturation code-drawn top-center expandable Boss Health Bar -->
  <GiantCreatureFramework.GiantHealthBarDef>
    <defName>GCF_HealthBar_TopBossClean</defName>
    <label>top-center expandable boss health bar</label>
    <topScreenMargin>16</topScreenMargin>
    <barWidth>540</barWidth>
    <mainBarHeight>28</mainBarHeight>
    <subRowHeight>24</subRowHeight>
    <subMeterWidth>164</subMeterWidth>
    <stackSpacing>10</stackSpacing>
    <maxVisibleSubRows>12</maxVisibleSubRows>
    <enterExpandSeconds>0.48</enterExpandSeconds>
    <exitCollapseSeconds>0.40</exitCollapseSeconds>
    <drawerToggleSpeed>12.0</drawerToggleSpeed>
    <damageLagDecayPerSecond>0.55</damageLagDecayPerSecond>
    <defaultExpanded>false</defaultExpanded>
    <showExpandButton>true</showExpandButton>
    <clickBarToSelectAndJump>true</clickBarToSelectAndJump>
    <hideFullHealthMinorLimbs>false</hideFullHealthMinorLimbs>
    <drawHierarchyLines>true</drawHierarchyLines>
    <backgroundColor>(0.075, 0.082, 0.100, 0.94)</backgroundColor>
    <drawerBackgroundColor>(0.068, 0.075, 0.092, 0.93)</drawerBackgroundColor>
    <borderColor>(0.580, 0.500, 0.340, 1.00)</borderColor>
    <lagBarColor>(0.940, 0.780, 0.420, 0.96)</lagBarColor>
    <healthyFillColor>(0.310, 0.640, 0.350, 1.00)</healthyFillColor>
    <woundedFillColor>(0.820, 0.580, 0.220, 1.00)</woundedFillColor>
    <criticalFillColor>(0.780, 0.240, 0.220, 1.00)</criticalFillColor>
    <textColor>(0.970, 0.955, 0.910, 1.00)</textColor>
  </GiantCreatureFramework.GiantHealthBarDef>

</Defs>

        <texPath>Things/Pawn/GiantCreature/MechScorpion/Carapace</texPath>
        <textureResolution>512</textureResolution>
        <drawSize>(3.6, 3.6)</drawSize>
        <pivotPixel>(256, 256)</pivotPixel>
        <layerOffset>0</layerOffset>
        <linkedBodyPart>GCF_MechCarapace</linkedBodyPart>
        <hideWhenMissing>false</hideWhenMissing>
        <contributesToHitbox>true</contributesToHitbox>
        <contributesToCollision>true</contributesToCollision>
        <alphaThreshold>32</alphaThreshold>
        <damageMultiplier>0.68</damageMultiplier>
        <armorMultiplier>1.55</armorMultiplier>
        <deflectChance>0.15</deflectChance>
        <hitVfxPreset>Sparks</hitVfxPreset>
        <partAttacks>
          <li>
            <attackId>scorpion_carapace_ram</attackId>
            <label>cephalothorax carapace</label>
            <kind>Melee</kind>
            <damageDef>Blunt</damageDef>
            <power>27</power>
            <armorPenetration>0.40</armorPenetration>
            <warmupTime>0.48</warmupTime>
            <cooldownTime>2.6</cooldownTime>
            <range>2.4</range>
            <sectorCenterDeg>0</sectorCenterDeg>
            <sectorHalfAngleDeg>55</sectorHalfAngleDeg>
            <knockbackDistance>1.5</knockbackDistance>
            <selectionWeight>0.35</selectionWeight>
            <attackAnim>GCF_Anim_MechScorpion_CarapaceRam</attackAnim>

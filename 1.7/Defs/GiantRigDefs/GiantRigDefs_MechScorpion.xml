<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 18-Node Top-Down 512x512 Vector-Art Skeletal Rig for Heavy Mechanical Scorpion (8 Legs + 7-Seg Tail) -->
  <GiantCreatureFramework.GiantRigDef>
    <defName>GCF_Rig_MechScorpion</defName>
    <label>heavy mechanical scorpion rig</label>
    <healthBarDef>GCF_HealthBar_TopBossClean</healthBarDef>
    <painImmune>true</painImmune>
    <onlyDieWhenCoreDestroyed>true</onlyDieWhenCoreDestroyed>

    <turnSpeedDegPerTick>2.20</turnSpeedDegPerTick>
    <hitCoverageThreshold>0.08</hitCoverageThreshold>
    <collisionCoverageThreshold>0.52</collisionCoverageThreshold>
    <collisionPathCost>10000</collisionPathCost>
    <coreClearanceRadius>1</coreClearanceRadius>
    <footprintUpdateIntervalTicks>2</footprintUpdateIntervalTicks>
    <walkCycleDistance>1.35</walkCycleDistance>
    <runCycleDistance>1.8</runCycleDistance>
    <turnCycleAngleDeg>42</turnCycleAngleDeg>
    <portraitScaleFactor>0.32</portraitScaleFactor>

    <rushWhenEnemyFar>true</rushWhenEnemyFar>
    <rushStartDistance>14</rushStartDistance>
    <rushStopDistance>8</rushStopDistance>
    <rushMoveSpeedMultiplier>1.45</rushMoveSpeedMultiplier>

    <crushBuildingsAndTerrain>true</crushBuildingsAndTerrain>
    <canCrushNaturalRock>true</canCrushNaturalRock>
    <canCrushConstructedBuildings>true</canCrushConstructedBuildings>
    <canCrushDestructibleTerrain>true</canCrushDestructibleTerrain>
    <crushDamagePerStep>320</crushDamagePerStep>
    <crushIntervalTicks>14</crushIntervalTicks>

    <meleeTouchRadius>2.0</meleeTouchRadius>
    <useDirectionalMeleeTools>true</useDirectionalMeleeTools>

    <walkAnim>GCF_Anim_MechScorpion_Walk</walkAnim>
    <turnLeftAnim>GCF_Anim_MechScorpion_TurnLeft</turnLeftAnim>
    <turnRightAnim>GCF_Anim_MechScorpion_TurnRight</turnRightAnim>
    <meleeAttackAnims>
      <li>GCF_Anim_MechScorpion_ClawLeft</li>
      <li>GCF_Anim_MechScorpion_ClawRight</li>
      <li>GCF_Anim_MechScorpion_CarapaceRam</li>
    </meleeAttackAnims>
    <rangedAttackAnim>GCF_Anim_MechScorpion_RangedTail</rangedAttackAnim>
    <rangedWeaponBoneId>tail_stinger</rangedWeaponBoneId>
    <weaponEmitters>
      <li>
        <emitterId>tail_plasma_stinger</emitterId>
        <fireMode>PrimaryWithFallback</fireMode>
        <replaceVanillaMuzzleFlash>true</replaceVanillaMuzzleFlash>
        <spawnMuzzleVfxOnLaunch>true</spawnMuzzleVfxOnLaunch>
        <vfxPresetOverride>PlasmaBurst</vfxPresetOverride>
        <vfxScale>1.05</vfxScale>
        <vfxColor>(0.35, 0.92, 1.0, 0.92)</vfxColor>
        <barrels>
          <li>
            <boneId>tail_stinger</boneId>
            <socketId>stinger_tip</socketId>
          </li>
        </barrels>
      </li>
    </weaponEmitters>
    <downedAnim>GCF_Anim_MechScorpion_Downed</downedAnim>
    <deathAnim>GCF_Anim_MechScorpion_Death</deathAnim>

    <steering>
      <enabled>true</enabled>
      <bodyTurnAccelDegPerTick2>0.72</bodyTurnAccelDegPerTick2>
      <bodyPathLookAheadCells>2</bodyPathLookAheadCells>
      <bodyPathLookAheadWeight>0.28</bodyPathLookAheadWeight>
      <gazePathLookAheadCells>5</gazePathLookAheadCells>
      <headLeadGateAngleDeg>50</headLeadGateAngleDeg>
      <minBodyTurnScaleWhileHeadLeads>0.55</minBodyTurnScaleWhileHeadLeads>
      <lookChains>
        <li>
          <chainId>claw_left_aim</chainId>
          <boneIds>
            <li>claw_left</li>
          </boneIds>
          <weights>
            <li>1.0</li>
          </weights>
          <maxChainAngleDeg>28</maxChainAngleDeg>
          <maxBoneAngleDeg>28</maxBoneAngleDeg>
          <turnSpeedDegPerTick>6.5</turnSpeedDegPerTick>
          <responsiveness>0.28</responsiveness>
          <combatTargetWeight>0.50</combatTargetWeight>
          <pathLookAheadWeight>0.35</pathLookAheadWeight>
          <idleScanAmplitudeDeg>0</idleScanAmplitudeDeg>
          <idleScanPeriodTicks>180</idleScanPeriodTicks>
          <locoWaveAmplitudeDeg>0</locoWaveAmplitudeDeg>
          <locoWavePeriodTicks>60</locoWavePeriodTicks>
          <oneShotClipSwayScale>0</oneShotClipSwayScale>
          <oneShotClipAimScale>1.0</oneShotClipAimScale>
        </li>
        <li>
          <chainId>claw_right_aim</chainId>
          <boneIds>
            <li>claw_right</li>
          </boneIds>
          <weights>
            <li>1.0</li>
          </weights>
          <maxChainAngleDeg>28</maxChainAngleDeg>
          <maxBoneAngleDeg>28</maxBoneAngleDeg>
          <turnSpeedDegPerTick>6.5</turnSpeedDegPerTick>
          <responsiveness>0.28</responsiveness>
          <combatTargetWeight>0.50</combatTargetWeight>
          <pathLookAheadWeight>0.35</pathLookAheadWeight>
          <idleScanAmplitudeDeg>0</idleScanAmplitudeDeg>
          <idleScanPeriodTicks>180</idleScanPeriodTicks>
          <locoWaveAmplitudeDeg>0</locoWaveAmplitudeDeg>
          <locoWavePeriodTicks>60</locoWavePeriodTicks>
          <oneShotClipSwayScale>0</oneShotClipSwayScale>
          <oneShotClipAimScale>1.0</oneShotClipAimScale>
        </li>
      </lookChains>
      <lagBones>
        <li>
          <boneId>tail_seg1</boneId>
          <followSpeedDegPerTick>2.30</followSpeedDegPerTick>
          <followResponsiveness>0.18</followResponsiveness>
          <forwardMotionAlignGain>2.2</forwardMotionAlignGain>
          <maxBendAngleDeg>18</maxBendAngleDeg>
        </li>
      </lagBones>
      <yawBankBones>
        <li>
          <boneId>tail_seg2</boneId>
          <yawRateGain>-1.1</yawRateGain>
          <maxAngleDeg>6</maxAngleDeg>
          <smoothing>0.24</smoothing>
        </li>
        <li>
          <boneId>tail_seg3</boneId>
          <yawRateGain>-1.4</yawRateGain>
          <maxAngleDeg>7</maxAngleDeg>
          <smoothing>0.24</smoothing>
        </li>
      </yawBankBones>
    </steering>

    <bezierChains>
      <li>
        <chainId>tail_main</chainId>
        <boneIds>
          <li>tail_seg1</li>
          <li>tail_seg2</li>
          <li>tail_seg3</li>
          <li>tail_seg4</li>
          <li>tail_seg5</li>
          <li>tail_seg6</li>
          <li>tail_stinger</li>
        </boneIds>
        <tipUV>(0.5, 0.21)</tipUV>
        <p1Frequency>0.22</p1Frequency>
        <p1Damping>0.74</p1Damping>
        <p2Frequency>0.14</p2Frequency>
        <p2Damping>0.62</p2Damping>
        <p3Frequency>0.095</p3Frequency>
        <p3Damping>0.52</p3Damping>
        <whipCrackGain>0.12</whipCrackGain>
        <waveLagCoupling>0.28</waveLagCoupling>
        <maxJointBendDeg>32</maxJointBendDeg>
        <idleWaveAmplitudeDeg>1.2</idleWaveAmplitudeDeg>
        <idleWavePeriodTicks>84</idleWavePeriodTicks>
        <velocityTrailingGain>16</velocityTrailingGain>
        <trailingMaxOffsetCells>1.2</trailingMaxOffsetCells>
        <trailingLateralSign>0</trailingLateralSign>
        <trailingLateralRatio>0</trailingLateralRatio>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GiantCreatureFramework.Agent.BridgeTools</AssemblyName>
    <RootNamespace>GiantCreatureFramework.Agent.BridgeTools</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <NuGetAudit>false</NuGetAudit>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <RimWorldPath Condition="'$(RimWorldPath)' == ''">D:\Steam\steamapps\common\RimWorld</RimWorldPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorldPath)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RimWorld"><HintPath>$(RimWorldPath)\RimWorld.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(RimWorldPath)\UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Waylith"><HintPath>$(RimWorldPath)\Waylith.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Waylith.UnityCompat"><HintPath>$(RimWorldPath)\Waylith.UnityCompat.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RimBridgeServer.Sdk"><HintPath>$(RimWorldPath)\Mods\RimBridgeServer\1.6\Assemblies\RimBridgeServer.Sdk.dll</HintPath><Private>false</Private></Reference>
    <ProjectReference Include="..\GiantCreatureFramework\GiantCreatureFramework.csproj"><Private>false</Private></ProjectReference>
    <ProjectReference Include="..\GiantCreatureFramework.Agent\GiantCreatureFramework.Agent.csproj"><Private>false</Private></ProjectReference>
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GameVersion Condition="'$(GameVersion)' == ''">1.7</GameVersion>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GiantCreatureFramework.Agent</RootNamespace>
    <AssemblyName>GiantCreatureFramework.Agent</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <NuGetAudit>false</NuGetAudit>
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <OutputPath>..\..\1.7\Assemblies\</OutputPath>
    <RimWorldPath Condition="'$(RimWorldPath)' == ''">D:\Steam\steamapps\common\RimWorld</RimWorldPath>
    <GameModPath>$(RimWorldPath)\Mods\GiantCreatureFramework</GameModPath>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GiantCreatureFramework.Agent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RimWorld">
      <HintPath>$(RimWorldPath)\RimWorld.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldPath)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldPath)\Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith.UnityCompat">
      <HintPath>$(RimWorldPath)\Waylith.UnityCompat.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(RimWorldPath)\Mods\Harmony\1.7\Assemblies\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <ProjectReference Include="..\GiantCreatureFramework\GiantCreatureFramework.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <Target Name="DeployAgentToRimWorld" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameModPath)\1.7\Assemblies" />
  </Target>
</Project>
